# Groq API Key (required to interact with Llama 3.3 70B)
GROQ_API_KEY=gsk_...

# CORS Allowed Origins (comma-separated origins). Do not use "*" in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional server configuration
PORT=8000
HOST=0.0.0.0

# NTREIS RETS Connection Configuration
NTREIS_RETS_URL=https://ntrdd.mlsmatrix.com/rets/login.ashx
NTREIS_RETS_USERNAME=your_rets_username
NTREIS_RETS_PASSWORD=your_rets_password
