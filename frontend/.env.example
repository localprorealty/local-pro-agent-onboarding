VITE_API_BASE_URL=http://localhost:8000

# Google Apps Script Web App Deployment URL (from Step 2 of docs/apps-script-setup.md)
VITE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Shared secret matching the SHARED_SECRET script property in Google Apps Script (client-side visible tradeoff)
VITE_SHEET_SHARED_SECRET=your-shared-secret-here

# Google OAuth Client ID for the Google Capture Section sign-in
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
